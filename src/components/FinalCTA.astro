---
import { useTranslations, type Locale } from '../i18n/index';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-16 lg:py-24 border-t border-shift-line">
  <div class="shift-container">
    <div class="relative bg-shift-surface border border-shift-line rounded-2xl p-8 sm:p-12 lg:p-16 overflow-hidden text-center">
      <!-- Background glow -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(199,255,74,0.06)_0%,transparent_70%)] pointer-events-none" aria-hidden="true"></div>

      <!-- Three i motif -->
      <div class="flex justify-center gap-1.5 mb-6" aria-hidden="true">
        <span class="w-0.5 h-8 bg-shift-accent rounded-full opacity-80"></span>
        <span class="w-0.5 h-8 bg-shift-accent rounded-full opacity-60"></span>
        <span class="w-0.5 h-8 bg-shift-accent rounded-full opacity-40"></span>
      </div>

      <h2 class="shift-heading-lg text-balance mb-4 relative z-10">
        {t('finalCta.title')}
      </h2>
      <p class="shift-body max-w-lg mx-auto mb-8 relative z-10">
        {t('finalCta.desc')}
      </p>
      <a href={`/${lang}/tools/business-audit`} class="shift-btn-primary text-base px-8 py-4 relative z-10">
        {t('finalCta.cta')}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
