import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, useTranslations, type Locale } from '../../../i18n/index';

export function getStaticPaths() {
  const paths: any[] = [];
  const slugs = ['automatable-work', 'right-sized-crm', 'website-system', 'ai-reality-check'];

  LOCALES.forEach((lang) => {
    slugs.forEach((slug) => {
      paths.push({
        params: { lang, slug },
      });
    });
  });

  return paths;
}

