---
import { type Locale } from '../i18n/index';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const label = {
  he: 'עבדנו עם',
  en: 'Worked with',
  es: 'Hemos trabajado con',
  ru: 'Работали с',
};

// Logos — text based (monospace display)
const logos = [
  'BRIDGIFY',
  'SWU',
  'PAZ INTERACTIVE',
  'ALCHEMIQ',
  'DOUGLAS & BLOOMBERG',
  'ENHANCE',
  'TREK MARKET',
  'FEMINISTIT',
  'CHEETAH',
];
---

<div class="logos-carousel-section py-12 border-t border-white/[0.06] overflow-hidden">
  <p class="font-mono text-[10px] tracking-widest uppercase text-shift-muted text-center mb-8">
    {label[lang]}
  </p>

  <div class="logos-track-wrapper relative">
    <!-- Fade edges -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-24 z-10 bg-gradient-to-r from-shift-bg to-transparent"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-24 z-10 bg-gradient-to-l from-shift-bg to-transparent"></div>

    <div class="logos-track flex items-center gap-16" aria-hidden="true">
      <!-- First set -->
      {logos.map((name) => (
        <span class="logos-item font-mono text-sm tracking-widest whitespace-nowrap text-[#F4F1EA]/40 hover:text-[#F4F1EA]/70 transition-colors duration-300 flex-shrink-0">
          {name}
        </span>
      ))}
      <!-- Separator -->
      <span class="logos-item text-shift-accent/30 flex-shrink-0 font-mono">◆</span>
      <!-- Duplicate for seamless loop -->
      {logos.map((name) => (
        <span class="logos-item font-mono text-sm tracking-widest whitespace-nowrap text-[#F4F1EA]/40 hover:text-[#F4F1EA]/70 transition-colors duration-300 flex-shrink-0">
          {name}
        </span>
      ))}
      <!-- Separator -->
      <span class="logos-item text-shift-accent/30 flex-shrink-0 font-mono">◆</span>
      <!-- Third set for safety -->
      {logos.map((name) => (
        <span class="logos-item font-mono text-sm tracking-widest whitespace-nowrap text-[#F4F1EA]/40 hover:text-[#F4F1EA]/70 transition-colors duration-300 flex-shrink-0">
          {name}
        </span>
      ))}
      <span class="logos-item text-shift-accent/30 flex-shrink-0 font-mono">◆</span>
    </div>
  </div>
</div>

<style>
  .logos-track-wrapper {
    overflow: hidden;
  }

  .logos-track {
    display: flex;
    width: max-content;
    animation: logos-scroll 30s linear infinite;
  }

  .logos-track:hover {
    animation-play-state: paused;
  }

  @keyframes logos-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-100% / 3));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logos-track {
      animation: none;
    }
  }
</style>
