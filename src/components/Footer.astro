---
import { useTranslations, type Locale, LOCALES, getLocalizedPath } from '../i18n/index';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
---

<footer class="border-t border-shift-line bg-shift-surface mt-16">
  <div class="shift-container py-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href={`/${lang}`} class="font-heading font-bold text-lg text-shift-text no-underline hover:text-shift-accent transition-colors">
          shiiift
        </a>
        <p class="mt-2 text-sm text-shift-muted max-w-xs leading-relaxed">
          {t('footer.tagline')}
        </p>
      </div>

      <!-- Tools & Pages -->
      <div>
        <p class="text-xs font-medium text-shift-text uppercase tracking-wider mb-4">{t('nav.tools')}</p>
        <ul class="space-y-2 text-sm text-shift-muted list-none p-0 m-0">
          <li><a href={`/${lang}/tools/business-audit`} class="hover:text-shift-text transition-colors no-underline">{t('tools.businessAudit.title')}</a></li>
          <li><a href={`/${lang}/tools/website-audit`} class="hover:text-shift-text transition-colors no-underline">{t('tools.websiteAudit.title')}</a></li>
          <li><a href={`/${lang}/tools/automation-finder`} class="hover:text-shift-text transition-colors no-underline">{t('tools.automationFinder.title')}</a></li>
          <li><a href={`/${lang}/tools/ai-readiness`} class="hover:text-shift-text transition-colors no-underline">{t('tools.aiReadiness.title')}</a></li>
          <li><a href={`/${lang}/tools/tool-stack`} class="hover:text-shift-text transition-colors no-underline">{t('tools.toolStack.title')}</a></li>
          <li><a href={`/${lang}/tools/lead-flow`} class="hover:text-shift-text transition-colors no-underline">{t('tools.leadFlow.title')}</a></li>
        </ul>
      </div>

      <!-- Site Links -->
      <div>
        <p class="text-xs font-medium text-shift-text uppercase tracking-wider mb-4">shiiift</p>
        <ul class="space-y-2 text-sm text-shift-muted list-none p-0 m-0">
          <li><a href={`/${lang}/thinking`} class="hover:text-shift-text transition-colors no-underline">{t('nav.thinking')}</a></li>
          <li><a href={`/${lang}/services`} class="hover:text-shift-text transition-colors no-underline">{t('services.label')}</a></li>
          <li><a href={`/${lang}/about`} class="hover:text-shift-text transition-colors no-underline">{t('about.label')}</a></li>
          <li><a href={`/${lang}/start`} class="hover:text-shift-text transition-colors no-underline">{t('nav.start')}</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-shift-line mt-8 pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <p class="text-xs text-shift-muted">
        &copy; {year} shiiift. {t('footer.rights')}.
      </p>
      <div class="flex items-center gap-3 text-xs text-shift-muted">
        {LOCALES.map((locale, idx) => (
          <>
            {idx > 0 && <span class="text-shift-line">|</span>}
            {locale === lang ? (
              <span class="text-shift-accent font-medium uppercase">{locale}</span>
            ) : (
              <a href={getLocalizedPath(currentPath, locale)} class="hover:text-shift-text transition-colors no-underline uppercase">
                {locale}
              </a>
            )}
          </>
        ))}
      </div>
    </div>
  </div>
</footer>
