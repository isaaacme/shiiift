---

<section class="py-16 lg:py-24 border-t border-shift-line" id="selected-projects">
  <div class="shift-container">

    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
      <div>
        <p class="shift-label mb-2">{gl(labels.sectionLabel)}</p>
        <h2 class="shift-heading-lg">{gl(labels.sectionDesc)}</h2>
      </div>
    </div>

    <!-- Projects grid: 3 cols on lg, 2 on md, 1 on sm -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="projects-grid">
      {projects.map((p) => (
        <button
          class="project-card text-start bg-white border border-shift-line rounded-xl p-5 flex flex-col gap-3 hover:border-shift-accent/40 hover:shadow-volume-md transition-all duration-200 cursor-pointer group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-shift-accent focus-visible:ring-offset-2 focus-visible:ring-offset-shift-bg hover:-translate-y-0.5"
          data-project={p.id}
          data-name={p.name}
          data-tag={gl(p.tag)}
          data-desc={gl(p.desc)}
          data-url={p.url}
          data-view={gl(labels.viewProject)}
          type="button"
          aria-haspopup="dialog"
        >
          <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] text-shift-muted border border-shift-line px-2 py-0.5 rounded">{gl(p.tag)}</span>
            <span class="font-mono text-[10px] text-shift-accent border border-shift-accent/20 bg-shift-accent/5 px-2 py-0.5 rounded">{gl(p.metric)}</span>
          </div>
          <span class="font-heading font-semibold text-shift-text text-sm leading-snug group-hover:text-shift-accent transition-colors">{p.name}</span>
          <span class="text-xs text-shift-muted leading-snug line-clamp-3 flex-1">{gl(p.desc)}</span>
          <span class="mt-auto font-mono text-xs text-shift-accent group-hover:text-shift-accent transition-colors flex items-center gap-1">
            {lang === 'he' ? '← ' : ''}{gl(labels.viewProject)}{lang !== 'he' ? ' →' : ''}
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- Lightbox overlay -->
<div
  id="project-lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
>
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" id="lightbox-backdrop"></div>
  <div class="relative z-10 bg-white border border-shift-line rounded-2xl p-8 max-w-lg w-full shadow-[0_8px_40px_rgba(0,0,0,0.12)]">
    <button id="lightbox-close" class="absolute top-4 end-4 text-shift-muted hover:text-shift-text transition-colors font-mono text-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-shift-accent focus-visible:ring-offset-2 focus-visible:ring-offset-shift-bg rounded p-1">
      ✕ {gl(labels.close)}
    </button>
    <span id="lb-tag" class="font-mono text-[10px] text-shift-muted border border-shift-line px-2 py-0.5 rounded mb-4 inline-block"></span>
    <h3 id="lb-name" class="font-heading font-bold text-2xl text-shift-text mb-3"></h3>
    <p id="lb-desc" class="text-sm text-shift-muted leading-relaxed mb-6"></p>
    <a id="lb-link" href="#" target="_blank" rel="noopener" class="shift-btn-primary text-sm px-5 py-2.5 inline-flex items-center gap-2">
      <span id="lb-cta"></span>
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
    </a>
  </div>
</div>

<script>
  const lb = document.getElementById('project-lightbox') as HTMLElement;
  const backdrop = document.getElementById('lightbox-backdrop');
  const closeBtn = document.getElementById('lightbox-close');

  function openLightbox(card: HTMLElement) {
    const name = card.dataset.name ?? '';
    const tag  = card.dataset.tag  ?? '';
    const desc = card.dataset.desc ?? '';
    const url  = card.dataset.url  ?? '#';
    const view = card.dataset.view ?? 'View project';
    (document.getElementById('lb-name') as HTMLElement).textContent = name;
    (document.getElementById('lb-tag')  as HTMLElement).textContent = tag;
    (document.getElementById('lb-desc') as HTMLElement).textContent = desc;
    (document.getElementById('lb-cta')  as HTMLElement).textContent = view;
    (document.getElementById('lb-link') as HTMLAnchorElement).href = url;
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.project-card').forEach((card) => {
    card.addEventListener('click', () => openLightbox(card as HTMLElement));
  });

  backdrop?.addEventListener('click', closeLightbox);
  closeBtn?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
</script>
