---

<section class="py-16 lg:py-24 border-t border-shift-line" id="about-founder">
  <div class="shift-container">

    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-start gap-12 mb-16">
      <div class="flex-1 max-w-xl">
        <p class="shift-label mb-3">{gl(labels.sectionLabel)}</p>
        <h2 class="shift-heading-lg mb-4">{gl(labels.name)}</h2>
        <p class="font-mono text-xs text-shift-accent mb-5">{gl(labels.role)}</p>
        <p class="shift-body leading-relaxed">{gl(labels.bio)}</p>
      </div>

      <!-- Can help -->
      <div class="lg:w-80 flex-shrink-0">
        <div class="bg-shift-surface border border-shift-line rounded-2xl p-6">
          <p class="font-mono text-xs tracking-widest uppercase text-[#C7FF4A] mb-4">{gl(labels.canHelpTitle)}</p>
          <ul class="space-y-3">
            {skills.map((s) => (
              <li class="flex items-start gap-3 text-sm text-shift-muted leading-snug">
                <span class="w-1.5 h-1.5 rounded-full bg-shift-accent flex-shrink-0 mt-1.5"></span>
                {gl(s)}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Projects grid -->
    <div class="mb-16">
      <p class="font-mono text-xs tracking-widest uppercase text-[#A7AFBA] mb-6">{gl(labels.projectsTitle)}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="projects-grid">
        {projects.map((p) => (
          <button
            class="project-card text-start bg-shift-surface border border-shift-line rounded-xl p-5 flex flex-col gap-3 hover:border-shift-accent/40 transition-all cursor-pointer group"
            data-project={p.id}
            data-name={p.name}
            data-tag={gl(p.tag)}
            data-desc={gl(p.desc)}
            data-url={p.url}
            data-view={gl(labels.viewProject)}
            type="button"
            aria-haspopup="dialog"
          >
            <span class="font-mono text-[10px] text-shift-muted border border-shift-line px-2 py-0.5 rounded self-start">{gl(p.tag)}</span>
            <span class="font-heading font-semibold text-shift-text text-sm leading-snug group-hover:text-shift-accent transition-colors">{p.name}</span>
            <span class="text-xs text-shift-muted leading-snug line-clamp-3">{gl(p.desc)}</span>
            <span class="mt-auto font-mono text-xs text-shift-accent/70 group-hover:text-shift-accent transition-colors">
              {lang === 'he' ? '← ' : ''}{gl(labels.viewProject)}{lang !== 'he' ? ' →' : ''}
            </span>
          </button>
        ))}
      </div>
    </div>

    <!-- Experience & qualifications -->
    <div>
      <p class="font-mono text-xs tracking-widest uppercase text-[#A7AFBA] mb-6">{gl(labels.expTitle)}</p>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {experience.map((e) => (
          <div class="bg-shift-surface border border-shift-line rounded-xl p-5 flex flex-col gap-2">
            {e.year && <span class="font-mono text-xs text-shift-accent">{e.year}</span>}
            <p class="font-heading font-semibold text-shift-text text-sm">{gl(e.title)}</p>
            <p class="text-xs text-shift-muted">{gl(e.note)}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- Lightbox overlay -->
<div
  id="project-lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
>
  <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="lightbox-backdrop"></div>
  <div class="relative z-10 bg-[#151A23] border border-shift-line rounded-2xl p-8 max-w-lg w-full shadow-[0_8px_40px_rgba(0,0,0,0.6)]">
    <button id="lightbox-close" class="absolute top-4 end-4 text-shift-muted hover:text-shift-text transition-colors font-mono text-xs">
      ✕ {gl(labels.close)}
    </button>
    <span id="lb-tag" class="font-mono text-[10px] text-shift-muted border border-shift-line px-2 py-0.5 rounded mb-4 inline-block"></span>
    <h3 id="lb-name" class="font-heading font-bold text-2xl text-shift-text mb-3"></h3>
    <p id="lb-desc" class="text-sm text-shift-muted leading-relaxed mb-6"></p>
    <a id="lb-link" href="#" target="_blank" rel="noopener" class="shift-btn-primary text-sm px-5 py-2.5 inline-flex items-center gap-2">
      <span id="lb-cta"></span>
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
    </a>
  </div>
</div>

<script>
  const lb = document.getElementById('project-lightbox') as HTMLElement;
  const backdrop = document.getElementById('lightbox-backdrop');
  const closeBtn = document.getElementById('lightbox-close');

  function openLightbox(card: HTMLElement) {
    const name = card.dataset.name ?? '';
    const tag  = card.dataset.tag  ?? '';
    const desc = card.dataset.desc ?? '';
    const url  = card.dataset.url  ?? '#';
    const view = card.dataset.view ?? 'View project';
    (document.getElementById('lb-name') as HTMLElement).textContent = name;
    (document.getElementById('lb-tag')  as HTMLElement).textContent = tag;
    (document.getElementById('lb-desc') as HTMLElement).textContent = desc;
    (document.getElementById('lb-cta')  as HTMLElement).textContent = view;
    (document.getElementById('lb-link') as HTMLAnchorElement).href = url;
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.project-card').forEach((card) => {
    card.addEventListener('click', () => openLightbox(card as HTMLElement));
  });

  backdrop?.addEventListener('click', closeLightbox);
  closeBtn?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
</script>
