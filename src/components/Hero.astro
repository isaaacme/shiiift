---
import { useTranslations, type Locale } from '../i18n/index';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32">
  <!-- Background grid -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(244,241,234,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(244,241,234,0.04)_1px,transparent_1px)] bg-[size:64px_64px] pointer-events-none" aria-hidden="true"></div>

  <!-- Layered Accent Glows -->
  <div class="absolute top-12 start-1/4 w-[500px] h-[350px] bg-shift-accent/6 rounded-full blur-[120px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-24 end-1/4 w-[450px] h-[300px] bg-shift-accent-2/4 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-48 start-1/3 w-[300px] h-[200px] bg-shift-warm/3 rounded-full blur-[90px] pointer-events-none" aria-hidden="true"></div>

  <div class="shift-container relative z-10">
    <div class="max-w-4xl">
      <!-- Pre-label -->
      <div class="inline-flex items-center gap-2 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-shift-accent"></span>
        <span class="shift-label">shiiift</span>
      </div>

      <!-- Headline -->
      <h1 class="shift-heading-xl text-balance mb-6">
        {t('hero.headline')}
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-shift-muted leading-relaxed max-w-2xl mb-10 text-balance">
        {t('hero.subheadline')}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-3 items-center">
        <a href={`/${lang}/tools/business-audit`} class="shift-btn-primary text-base px-6 py-3.5">
          {t('hero.cta.primary')}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <!-- <a href={`/${lang}/workshop`} class="shift-btn-secondary text-base px-6 py-3.5">
          {t('hero.cta.secondary')}
        </a> -->
        <a href={`/${lang}/thinking`} class="shift-btn-ghost text-base">
          {t('hero.cta.tertiary')}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Visual system diagram -->
    <div class="mt-16 lg:mt-20 relative">
      <div class="shift-card max-w-3xl overflow-hidden backdrop-blur-md bg-opacity-70">
        <div class="flex items-center justify-between mb-6">
          <p class="shift-label text-xs">
            {lang === 'he' ? 'זרימת מערכת תפעולית' : lang === 'ru' ? 'Операционный системный поток' : lang === 'es' ? 'Flujo del sistema operativo' : 'Operational System Flow'}
          </p>
          <span class="text-[9px] font-mono text-shift-muted/40 uppercase tracking-widest">Console v1.0.4</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {[
            { name: { he: 'טפסים', en: 'Forms', es: 'Formularios', ru: 'Формы' }, status: 'READY', color: 'accent' },
            { name: { he: 'וואטסאפ', en: 'WhatsApp', es: 'WhatsApp', ru: 'WhatsApp' }, status: 'LIVE', color: 'warm' },
            { name: { he: 'אימייל', en: 'Email', es: 'Email', ru: 'Email' }, status: 'SYNC', color: 'accent-2' },
            { name: { he: 'CRM', en: 'CRM', es: 'CRM', ru: 'CRM' }, status: 'CONN', color: 'accent' },
            { name: { he: 'חשבוניות', en: 'Invoices', es: 'Facturas', ru: 'Счета' }, status: 'AUTO', color: 'warm' },
            { name: { he: 'דוחות', en: 'Reports', es: 'Reportes', ru: 'Отчёты' }, status: 'LIVE', color: 'accent-2' },
            { name: { he: 'מעקב', en: 'Follow-ups', es: 'Seguimiento', ru: 'Ремаркетинг' }, status: 'RUN', color: 'accent' },
            { name: { he: 'אנליטיקס', en: 'Analytics', es: 'Analítica', ru: 'Аналитика' }, status: 'OK', color: 'accent-2' },
          ].map((item, i) => {
            const dotColor = item.color === 'accent' ? 'bg-shift-accent' : item.color === 'accent-2' ? 'bg-shift-accent-2' : 'bg-shift-warm';
            const textColor = item.color === 'accent' ? 'text-shift-accent' : item.color === 'accent-2' ? 'text-shift-accent-2' : 'text-shift-warm';
            const hoverBorder = item.color === 'accent' ? 'group-hover:border-shift-accent/30' : item.color === 'accent-2' ? 'group-hover:border-shift-accent-2/30' : 'group-hover:border-shift-warm/30';
            return (
              <div
                class={`bg-shift-surface-soft/80 border border-shift-line rounded-xl p-3 text-xs font-mono transition-all duration-300 hover:bg-shift-surface hover:-translate-y-0.5 hover:shadow-sm group ${hoverBorder}`}
                style={`animation-delay: ${i * 80}ms`}
              >
                <div class="flex items-center justify-between mb-2">
                  <span class={`w-1.5 h-1.5 rounded-full ${dotColor} animate-pulse`}></span>
                  <span class="text-[9px] text-shift-muted/30 font-mono tracking-wider">0{i+1}_SYS</span>
                </div>
                <p class="text-shift-text font-medium text-[13px] group-hover:text-shift-text transition-colors">{item.name[lang] ?? item.name.en}</p>
                <div class="mt-2 flex items-center justify-between pt-1.5 border-t border-white/[0.04]">
                  <span class={`text-[9px] uppercase tracking-wider font-semibold ${textColor}`}>{item.status}</span>
                  <span class="text-[8px] text-shift-muted/30">100ms</span>
                </div>
              </div>
            );
          })}
        </div>
        <div class="mt-5 flex items-center gap-3">
          <div class="bg-shift-accent/10 border border-shift-accent/30 rounded-lg px-4 py-2 font-mono text-sm text-shift-accent font-medium shadow-inner">
            {lang === 'he' ? 'מערכת' : lang === 'ru' ? 'Система' : lang === 'es' ? 'Sistema' : 'System'}
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-shift-accent rtl:rotate-180">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
          <div class="flex-1 h-px bg-shift-line relative overflow-hidden">
            <div class={`absolute inset-y-0 w-1/2 bg-gradient-to-r from-transparent via-shift-accent to-transparent animate-[shimmer_2s_ease-in-out_infinite] ${lang === 'he' ? 'end-0 shimmer-rtl' : 'start-0'}`}></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(200%); }
  }
  @keyframes shimmer-rtl {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-200%); }
  }
  .shimmer-rtl {
    animation-name: shimmer-rtl !important;
  }
</style>
