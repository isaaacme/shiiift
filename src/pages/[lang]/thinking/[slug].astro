const article = ARTICLES[slug]?.[lang] ?? ARTICLES[slug]?.['en'];
if (!article) return Astro.redirect(`/${lang}/thinking`);
---

<BaseLayout title={article.title} description={article.description} lang={lang}>
  <div class="py-16 lg:py-24">
    <div class="shift-container max-w-2xl">

      <div class="mb-10">
        <div class="flex items-center gap-3 mb-6">
          <a href={`/${lang}/thinking`} class="font-mono text-xs text-shift-muted hover:text-shift-accent transition-colors no-underline">
            {lang === 'he' ? '→ חזרה לחשיבה' : lang === 'ru' ? '← Назад к материалам' : lang === 'es' ? '← Volver a artículos' : '← Back to thinking'}
          </a>
        </div>
        <span class="font-mono text-xs text-shift-muted border border-shift-line px-2 py-0.5 rounded-md">{article.category}</span>
        <h1 class="font-heading font-bold text-3xl lg:text-4xl text-shift-text leading-tight mt-4 mb-3">{article.title}</h1>
        <p class="text-shift-muted font-mono text-sm">{article.date}</p>
      </div>

      <div class="space-y-6">
        {article.body.map((paragraph) => (
          <p class="text-shift-text leading-relaxed text-lg">{paragraph}</p>
        ))}
      </div>

      <div class="mt-16 pt-8 border-t border-shift-line">
        <p class="font-mono text-xs text-shift-muted mb-4 uppercase tracking-widest">
          {lang === 'he' ? 'כלים קשורים' : lang === 'ru' ? 'Связанные инструменты' : lang === 'es' ? 'Herramientas relacionadas' : 'Related tools'}
        </p>
        <a
          href={`/${lang}/tools`}
          class="inline-flex items-center gap-2 text-sm text-shift-muted hover:text-shift-accent font-mono transition-colors no-underline"
        >
          {lang === 'he' ? 'לכל הכלים' : lang === 'ru' ? 'Все инструменты' : lang === 'es' ? 'Ver todos los diagnósticos' : 'View all diagnostic tools'}
