---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostHog from '../components/posthog.astro';
import { isRTL, type Locale } from '../i18n/index';
import { SEO } from 'astro-seo';

interface Props {
  title: string;
  description?: string;
  lang: Locale;
  ogImage?: string;
}

const { title, description = 'Technology implementation for businesses that need leverage.', lang, ogImage } = Astro.props;
const dir = isRTL(lang) ? 'rtl' : 'ltr';
const siteUrl = Astro.site ? Astro.site.toString() : 'https://shiiift.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const finalMetaImage = new URL(ogImage || '/images/themeta.png', siteUrl).toString();
---

<!doctype html>
<html lang={lang} dir={dir} class="bg-shift-bg text-shift-text antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SEO
      title={`${title} — shiiift`}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title: `${title} — shiiift`,
          type: "website",
          image: finalMetaImage,
          url: canonicalURL.toString(),
        },
        optional: {
          description: description,
          siteName: "shiiift",
        }
      }}
      twitter={{
        card: "summary_large_image",
        site: "@isaaacme",
        creator: "@isaaacme",
      }}
      extend={{
        link: [
          { rel: "alternate", hreflang: "he", href: new URL(`/he${Astro.url.pathname.replace(/^\/(he|en|es|ru)/, '')}`, siteUrl).toString() },
          { rel: "alternate", hreflang: "en", href: new URL(`/en${Astro.url.pathname.replace(/^\/(he|en|es|ru)/, '')}`, siteUrl).toString() },
          { rel: "alternate", hreflang: "es", href: new URL(`/es${Astro.url.pathname.replace(/^\/(he|en|es|ru)/, '')}`, siteUrl).toString() },
          { rel: "alternate", hreflang: "ru", href: new URL(`/ru${Astro.url.pathname.replace(/^\/(he|en|es|ru)/, '')}`, siteUrl).toString() },
          { rel: "alternate", hreflang: "x-default", href: new URL(`/he${Astro.url.pathname.replace(/^\/(he|en|es|ru)/, '')}`, siteUrl).toString() }
        ]
      }}
    />

    <PostHog />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import Lenis from 'lenis';

      // Initialize smooth scroll
      const lenis = new Lenis({
        autoRaf: true,
      });

      // Save current language preference
      const lang = document.documentElement.lang;
      if (lang) {
        localStorage.setItem('shiiift-locale', lang);
      }

      // Intersection Observer for scroll reveal animations (triggers on enter, resets on exit)
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal-active');
            } else {
              entry.target.classList.remove('reveal-active');
            }
          });
        },
        {
          root: null,
          rootMargin: '0px 0px -8% 0px',
          threshold: 0.02,
        }
      );

      // Observe all elements with .reveal-on-scroll
      const observeElements = () => {
        document.querySelectorAll('.reveal-on-scroll:not(.reveal-observed)').forEach((el) => {
          el.classList.add('reveal-observed');
          revealObserver.observe(el);
        });
      };

      observeElements();

      // Mutation Observer to watch for dynamic elements (e.g. React components)
      const mutationObserver = new MutationObserver(() => {
        observeElements();
      });

      mutationObserver.observe(document.body, {
        childList: true,
        subtree: true,
      });
    </script>

    <!-- Hidden SVG dither filters -->
    <svg class="sr-only" xmlns="http://www.w3.org/2000/svg" width="0" height="0">
      <defs>
        <filter id="dither-duotone" x="0%" y="0%" width="100%" height="100%">
          <!-- Grayscale color matrix -->
          <feColorMatrix type="matrix" values="0.299 0.587 0.114 0 0
                                               0.299 0.587 0.114 0 0
                                               0.299 0.587 0.114 0 0
                                               0 0 0 1 0" result="gray" />
          <!-- Generate high frequency noise -->
          <feTurbulence type="fractalNoise" baseFrequency="0.95" numOctaves="1" result="noise" />
          <!-- Mix noise with the grayscale image -->
          <feComposite operator="arithmetic" k1="0.5" k2="0.6" k3="0.2" k4="-0.1" in="gray" in2="noise" result="mixed" />
          <!-- Apply contrast threshold to create dither look -->
          <feComponentTransfer result="dither">
            <feFuncR type="discrete" tableValues="0 1" />
            <feFuncG type="discrete" tableValues="0 1" />
            <feFuncB type="discrete" tableValues="0 1" />
          </feComponentTransfer>
          <!-- Map values: Cobalt Blue (#0047FF) for black and Electric Yellow (#FFE600) for white -->
          <feComponentTransfer in="dither">
            <feFuncR type="linear" slope="1" intercept="0" />
            <feFuncG type="linear" slope="0.622" intercept="0.278" />
            <feFuncB type="linear" slope="-1" intercept="1" />
          </feComponentTransfer>
        </filter>
        <filter id="dither-mono" x="0%" y="0%" width="100%" height="100%">
          <feColorMatrix type="matrix" values="0.299 0.587 0.114 0 0
                                               0.299 0.587 0.114 0 0
                                               0.299 0.587 0.114 0 0
                                               0 0 0 1 0" result="gray" />
          <feTurbulence type="fractalNoise" baseFrequency="0.95" numOctaves="1" result="noise" />
          <feComposite operator="arithmetic" k1="0.5" k2="0.6" k3="0.2" k4="-0.1" in="gray" in2="noise" result="mixed" />
          <feComponentTransfer>
            <feFuncR type="discrete" tableValues="0 1" />
            <feFuncG type="discrete" tableValues="0 1" />
            <feFuncB type="discrete" tableValues="0 1" />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>
  </body>
</html>
