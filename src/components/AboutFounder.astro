---
import { type Locale } from '../i18n/index';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const labels = {
  sectionLabel: { he: 'על המייסד', en: 'About', es: 'Sobre el fundador', ru: 'Об основателе' },
  name:         { he: 'יצחק פלדמן', en: 'Isaac Feldman', es: 'Isaac Feldman', ru: 'Исаак Фельдман' },
  role:         { he: 'מייסד Shiiift', en: 'Founder, Shiiift', es: 'Fundador, Shiiift', ru: 'Основатель, Shiiift' },
  bio:          {
    he: 'אני מבלה את הזמן שלי במציאת דרכים מעשיות לעזור לאנשים לעשות פחות עבודה חוזרת ולנצל טוב יותר את הטכנולוגיה. אם משהו כאן נראה שימושי, פשוט בחרו כלי והתחילו.',
    en: 'I spend my time finding practical ways to help people do less repetitive work and make better use of technology. If something here looks useful, just pick a tool and get started.',
    es: 'Dedico mi tiempo a encontrar formas prácticas de ayudar a las personas a hacer menos trabajo repetitivo y aprovechar mejor la tecnología. Si algo aquí parece útil, elige una herramienta y empieza.',
    ru: 'Я трачу время на поиск практичных способов помочь людям делать меньше рутинной работы и лучше использовать технологии. Если что-то здесь кажется полезным — просто выберите инструмент.',
  },
  cta:          { he: 'בואו נעשה את הצעד הראשון ביחד', en: "Let's take the first step together", es: 'Demos el primer paso juntos', ru: 'Давайте сделаем первый шаг вместе' },
  portfolio:    { he: 'פורטפוליו', en: 'Portfolio', es: 'Portafolio', ru: 'Портфолио' },
};

function gl(o: Record<string, string>) { return o[lang] ?? o['en'] ?? ''; }
---

<section class="py-24 relative overflow-hidden bg-parallax-grid" id="about-founder">
  <!-- Premium ambient glow backdrop -->
  <div class="absolute -top-12 left-1/3 w-96 h-96 bg-shift-accent/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-12 right-1/4 w-96 h-96 bg-shift-warm/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="shift-container max-w-5xl">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Left Column: Photo Container with yellow dither framing, tilted -->
      <div class="md:col-span-4 flex justify-center md:justify-start reveal-on-scroll" style="--stagger-index: 1;">
        <div class="dither-wrap-yellow w-60 h-60 md:w-full md:h-auto md:aspect-square transition-transform duration-300 hover:rotate-2 shadow-volume-lg transform -rotate-2">
          <img
            src="/isaac-feldman.png"
            alt={gl(labels.name)}
            class="dither-img"
          />
        </div>
      </div>

      <!-- Right Column: Content, unbordered poster block -->
      <div class="md:col-span-8 flex flex-col items-start reveal-on-scroll" style="--stagger-index: 2;">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono tracking-wider uppercase bg-shift-accent/10 text-shift-accent mb-6 border border-shift-accent/15">
          <span class="w-1.5 h-1.5 rounded-full bg-shift-accent animate-pulse"></span>
          {gl(labels.sectionLabel)}
        </div>

        <h3 class="font-heading font-extrabold text-shift-text text-4xl sm:text-5xl lg:text-6xl tracking-tight mb-2 uppercase leading-[0.95]">{gl(labels.name)}</h3>
        <p class="font-mono text-xs text-shift-muted/80 tracking-widest mb-6 uppercase">{gl(labels.role)}</p>

        <p class="text-shift-muted text-lg sm:text-xl leading-relaxed mb-8 max-w-2xl text-balance">
          {gl(labels.bio)}
        </p>

        <div class="flex flex-wrap items-center gap-5">
          <a href={`/${lang}/start`} class="shift-btn-primary text-base px-6 py-4 shadow-volume-md hover:shadow-volume-lg transition-transform hover:-rotate-1">
            {gl(labels.cta)}
          </a>
          <a
            href="https://isaaac.me"
            target="_blank"
            rel="noopener noreferrer"
            class="group/link inline-flex items-center gap-2 text-xs font-mono text-shift-muted hover:text-shift-accent transition-colors py-2"
          >
            <span>{gl(labels.portfolio)}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180 transform transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
