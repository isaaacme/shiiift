---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutFounder from '../../components/AboutFounder.astro';
import ProjectsSection from '../../components/ProjectsSection.astro';
import OSConsole from '../../components/tools/OSConsole';
import { LOCALES, useTranslations, type Locale } from '../../i18n/index';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const isRtl = lang === 'he';

// Build translation properties for the React console
const tProps = {
  back: t('tool.back'),
  next: t('tool.next'),
  seeResults: t('tool.seeResults'),
  startOver: t('tool.startOver'),
  yourScore: t('tool.yourScore'),
  topFindings: t('tool.topFindings'),
  quickWins: t('tool.quickWins'),
  nextActions: t('tool.nextActions'),
  relatedTools: t('tool.relatedTools'),
  newsletterTitle: t('tool.newsletter.title'),
  newsletterPlaceholder: t('tool.newsletter.placeholder'),
  newsletterCta: t('tool.newsletter.cta'),
  newsletterDisclaimer: t('tool.newsletter.disclaimer'),
  lang,
  searchPlaceholder: t('console.searchPlaceholder' as any),
  allTools: t('console.categories.all' as any),
  diagnosticTitle: t('diagnostic.title'),
  diagnosticSubtitle: t('diagnostic.subtitle'),
  backToDashboard: t('console.backToDashboard' as any),
  runTool: t('console.runTool' as any),
  timeLabel: t('tools.time'),
  outputLabel: t('console.outputLabel' as any),
  categories: {
    all: t('console.categories.all' as any),
    leads: t('console.categories.leads' as any),
    ops: t('console.categories.ops' as any),
    ai: t('console.categories.ai' as any),
    strategy: t('console.categories.strategy' as any),
    finance: t('console.categories.finance' as any),
  },
  tools: {
    businessAudit: {
      title: t('tools.businessAudit.title'),
      desc: t('tools.businessAudit.desc'),
      time: t('tools.businessAudit.time'),
      output: t('tools.businessAudit.output'),
    },
    websiteAudit: {
      title: t('tools.websiteAudit.title'),
      desc: t('tools.websiteAudit.desc'),
      time: t('tools.websiteAudit.time'),
      output: t('tools.websiteAudit.output'),
    },
    automationFinder: {
      title: t('tools.automationFinder.title'),
      desc: t('tools.automationFinder.desc'),
      time: t('tools.automationFinder.time'),
      output: t('tools.automationFinder.output'),
    },
    aiReadiness: {
      title: t('tools.aiReadiness.title'),
      desc: t('tools.aiReadiness.desc'),
      time: t('tools.aiReadiness.time'),
      output: t('tools.aiReadiness.output'),
    },
    toolStack: {
      title: t('tools.toolStack.title'),
      desc: t('tools.toolStack.desc'),
      time: t('tools.toolStack.time'),
      output: t('tools.toolStack.output'),
    },
    leadFlow: {
      title: t('tools.leadFlow.title'),
      desc: t('tools.leadFlow.desc'),
      time: t('tools.leadFlow.time'),
      output: t('tools.leadFlow.output'),
    },
    pricingCalculator: {
      title: t('tools.pricingCalculator.title' as any),
      desc: t('tools.pricingCalculator.desc' as any),
      time: t('tools.pricingCalculator.time' as any),
      output: t('tools.pricingCalculator.output' as any),
    },
    proposalBuilder: {
      title: t('tools.proposalBuilder.title' as any),
      desc: t('tools.proposalBuilder.desc' as any),
      time: t('tools.proposalBuilder.time' as any),
      output: t('tools.proposalBuilder.output' as any),
    },
  },
};

const heroTitle = {
  he: 'האם המשאבים בעסק שלכם\nמוקצים למקומות הנכונים?',
  en: 'Spend less time\non repetitive work.',
  es: 'Dedica menos tiempo\nal trabajo repetitivo.',
  ru: 'Меньше повторяющейся\nработы. Больше времени.',
};

const heroDesc = {
  he: 'אנחנו משלבים ניסיון עסקי, טכנולוגי ותפעולי כדי לזהות איפה העסק שלכם מאבד זמן, כסף ואנרגיה — ולבנות מערכות מותאמות שמחזירות את המשאבים האלה למקומות שבהם הם מייצרים את הערך הגבוה ביותר.',
  en: 'I build high-performance websites, workflow automations, and practical AI systems that save you precious time. Instead of marketing slogans, I built these tools to help you identify bottlenecks in your business right now. Answer a few questions below and get a realistic technical scope and budget estimate in minutes.',
  es: 'Construyo sitios web rápidos, automatizaciones y sistemas de IA que te ahorran tiempo valioso. En lugar de promesas de marketing, he creado estas herramientas para que identifiques cuellos de botella en tu negocio hoy mismo. Responde unas preguntas abajo y obtén un presupuesto real en minutos.',
  ru: 'Я создаю быстрые сайты, автоматизирую процессы и внедряю ИИ-системы, чтобы сэкономить ваше время. Вместо громких лозунгов я сделал эти инструменты для поиска узких мест в вашем бизнесе прямо сейчас. Ответьте на несколько вопросов ниже и получите оценку бюджета за пару минут.',
};

const heroCta = {
  he: 'בחרו כלי',
  en: 'Choose a tool',
  es: 'Elegir herramienta',
  ru: 'Выбрать инструмент',
};

const heroCtaSecondary = {
  he: 'שוחחו עם יצחק',
  en: 'Talk to Isaac',
  es: 'Hablar con Isaac',
  ru: 'Поговорить с Исааком',
};

const ctaHeadline = {
  he: 'מוכנים לקבל זמן חזרה?',
  en: 'Ready to get some time back?',
  es: '¿Listo para recuperar tiempo?',
  ru: 'Готовы вернуть себе время?',
};

const ctaSub = {
  he: 'בחרו כלי או קבעו שיחה קצרה. בכל מקרה תצאו עם משהו שימושי.',
  en: 'Pick a tool or book a short call. Either way, you\'ll leave with something useful.',
  es: 'Elige una herramienta o agenda una llamada. De cualquier manera, saldrás con algo útil.',
  ru: 'Выберите инструмент или запишитесь на звонок. В любом случае вы уйдёте с чем-то полезным.',
};

const ctaBtn = {
  he: 'בחרו כלי',
  en: 'Choose a tool',
  es: 'Elegir herramienta',
  ru: 'Выбрать инструмент',
};

const ctaBtnSecondary = {
  he: 'שוחחו עם יצחק',
  en: 'Talk to Isaac',
  es: 'Hablar con Isaac',
  ru: 'Поговорить',
};

const philosophyLabel = {
  he: 'פילוסופיית רשת',
  en: 'Web Philosophy',
  es: 'Filosofía web',
  ru: 'Философия веба',
};

const philosophyTitle = {
  he: 'למה הכלים האלה כאן? החזון שלנו ל״אתרים של עכשיו״',
  en: 'Why are these tools here? Our vision for "sites for now"',
  es: '¿Por qué están estas herramientas aquí? Nuestra visión de "sitios para el ahora"',
  ru: 'Почему эти инструменты здесь? Наше видение «сайтов для настоящего»',
};

const philosophyPara1 = {
  he: 'רוב האתרים העסקיים כיום הם כמו עלוני פרסום דיגיטליים משעממים. בעידן של בינה מלאכותית, לאתר אינטרנט אין זכות קיום רק בגלל שלעסק ״חייב להיות אתר״. אם המידע באתר שלכם יכול להיות מוגש טוב יותר על ידי שאילתה פשוטה ב-ChatGPT, האתר שלכם מיותר.',
  en: 'Most business websites today are static digital brochures. In the age of AI, a website has no reason to exist simply because "businesses need sites." If the content on your site can be answered better by asking ChatGPT, your site is obsolete.',
  es: 'La mayoría de los sitios web comerciales hoy son folletos digitales estáticos. En la era de la IA, un sitio web no tiene sentido si existe solo porque "las empresas necesitan sitios". Si el contenido de tu sitio puede ser respondido mejor por ChatGPT, tu sitio es obsoleto.',
  ru: 'Большинство бизнес-сайтов сегодня — это просто статичные цифровые буклеты. В эпоху ИИ у сайта нет причин для существования только потому, что «бизнесу нужен сайт». Если на любой вопрос о ваших услугах ChatGPT ответит быстрее и лучше, ваш сайт устарел.',
};

const philosophyPara2 = {
  he: 'אתר מודרני חייב להביא ערך מוחשי ומיידי למבקרים מהשנייה הראשונה. זו הסיבה שהפכנו את דף הבית של שיפט לפלטפורמה של כלים מעשיים ואינטראקטיביים. כאן אתם לא קוראים על מה שאנחנו יכולים לעשות — אתם מקבלים אפיון אמיתי, הערכת תקציב מדויקת, אופטימיזציית ביצועים ותוכנית פעולה לעסק שלכם, באופן מיידי ובחינם. זה הערך שאנחנו מאמינים בו.',
  en: 'A modern website must deliver concrete, immediate value from the first second. That is why we transformed Shiiift\'s homepage into an interactive workbench. You don\'t just read about what we do—you actively diagnose bottlenecks, estimate project budgets, and build custom proposals. We justify your visit by giving you immediate utility before we ever ask for an email or a call.',
  es: 'Un sitio web moderno debe ofrecer valor concreto e inmediato desde el primer segundo. Por eso transformamos la portada de Shiiift en una plataforma de herramientas de diagnóstico interactivas. No solo lees sobre lo que hacemos: obtienes diagnósticos, estimaciones de presupuestos y propuestas de inmediato y sin fricciones.',
  ru: 'Современный сайт обязан приносить реальную пользу с первых секунд. Вот почему мы превратили главную страницу Shiiift в интерактивную панель инструментов. Вы не просто читаете о наших услугах — вы мгновенно выявляете узкие места, оцениваете бюджеты и получаете готовые коммерческие предложения.',
};
---

<BaseLayout
  title={lang === 'he' ? 'האם המשאבים בעסק שלכם מוקצים למקומות הנכונים?' : lang === 'es' ? 'Menos trabajo repetitivo. Más tiempo para lo que importa.' : lang === 'ru' ? 'Меньше рутины. Больше времени.' : 'Spend less time on repetitive work.'}
  description={heroDesc[lang]}
  lang={lang}
>

  <!-- ──────────────────────────── HERO ──────────────────────────── -->
  <section class="relative overflow-hidden pt-32 pb-24 bg-parallax-grid border-b border-shift-line">
    <!-- Layered decorative glows behind centered content -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-shift-accent/6 via-shift-accent-2/4 to-transparent rounded-full blur-[130px] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-12 left-1/3 w-[300px] h-[300px] bg-shift-warm/3 rounded-full blur-[90px] pointer-events-none" aria-hidden="true"></div>
    
    <div class="shift-container text-center relative z-10">
      <div class="reveal-on-scroll inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-shift-line/80 shadow-sm text-xs font-mono font-medium text-shift-muted mb-8 tracking-tight" style="--stagger-index: 0;">
        <span class="w-1.5 h-1.5 rounded-full bg-shift-accent animate-pulse"></span>
        {lang === 'he' ? 'שותף טכנולוגי ליישום מערכות' : lang === 'es' ? 'Socio de Integración Tecnológica' : lang === 'ru' ? 'Технологический партнер' : 'Technical Integration Partner'}
      </div>

      <h1 class="reveal-on-scroll font-heading font-extrabold text-4xl sm:text-5xl lg:text-[5rem] tracking-tighter leading-none text-shift-text mb-8 text-balance max-w-5xl mx-auto" style="white-space: pre-line; --stagger-index: 1;">
        {heroTitle[lang]}
      </h1>

      <p class="reveal-on-scroll text-base sm:text-lg md:text-xl text-shift-muted/80 leading-relaxed mb-10 max-w-3xl mx-auto text-balance font-light" style="--stagger-index: 2;">
        {heroDesc[lang]}
      </p>

      <div class="reveal-on-scroll flex flex-col sm:flex-row items-center justify-center gap-4 w-full" style="--stagger-index: 3;">
        <a
          href="#tools-section"
          class="shift-btn-primary px-8 py-3.5 text-base shadow-volume-accent hover:scale-[1.02] active:scale-[0.98] transition-all"
        >
          {heroCta[lang]}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </a>
        <a
          href={`/${lang}/start`}
          class="shift-btn-secondary px-8 py-3.5 text-base hover:scale-[1.02] active:scale-[0.98] transition-all"
        >
          {heroCtaSecondary[lang]}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ──────────────────────────── TOOLS CONSOLE ──────────────────────────── -->
  <section class="pb-20 bg-shift-surface border-y border-shift-line" id="tools-section">
    <div class="pt-16 pb-2 shift-container max-w-5xl mb-8 reveal-on-scroll">
      <p class="shift-label mb-2">{t('tools.section.title')}</p>
      <p class="text-shift-muted text-sm">{t('tools.section.subtitle')}</p>
    </div>
    <div>
      <OSConsole client:load lang={lang} t={tProps} />
    </div>
  </section>

  <!-- ──────────────────────────── PHILOSOPHY: SITES FOR NOW ──────────────────────────── -->
  <section class="py-24 bg-shift-bg border-b border-shift-line relative overflow-hidden bg-parallax-grid">
    <div class="shift-container max-w-3xl">
      <p class="reveal-on-scroll shift-label mb-3" style="--stagger-index: 0;">{philosophyLabel[lang]}</p>
      <h2 class="reveal-on-scroll font-heading font-extrabold text-3xl sm:text-4xl text-shift-text mb-8 tracking-tight leading-tight" style="--stagger-index: 1;">
        {philosophyTitle[lang]}
      </h2>
      <div class="space-y-6 text-base sm:text-lg text-shift-muted leading-relaxed">
        <p class="reveal-on-scroll" style="--stagger-index: 2;">
          {philosophyPara1[lang]}
        </p>
        <p class="reveal-on-scroll" style="--stagger-index: 3;">
          {philosophyPara2[lang]}
        </p>
      </div>
    </div>
  </section>

  <!-- ──────────────────────────── PROJECTS ──────────────────────────── -->
  <ProjectsSection lang={lang} />

  <!-- ──────────────────────────── ABOUT (compact) ──────────────────────────── -->
  <AboutFounder lang={lang} />

  <!-- ──────────────────────────── CTA ──────────────────────────── -->
  <section class="py-20 border-t border-shift-line">
    <div class="shift-container max-w-2xl text-center mx-auto">
      <h2 class="reveal-on-scroll shift-heading-lg mb-4" style="--stagger-index: 0;">{ctaHeadline[lang]}</h2>
      <p class="reveal-on-scroll shift-body mb-8 text-base" style="--stagger-index: 1;">{ctaSub[lang]}</p>
      <div class="reveal-on-scroll flex flex-col sm:flex-row items-center justify-center gap-3" style="--stagger-index: 2;">
        <a href="#tools-section" class="shift-btn-primary px-7 py-3">
          {ctaBtn[lang]}
        </a>
        <a href={`/${lang}/start`} class="shift-btn-secondary px-7 py-3">
          {ctaBtnSecondary[lang]}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
