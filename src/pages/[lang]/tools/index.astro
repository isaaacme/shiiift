---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, useTranslations, type Locale } from '../../../i18n/index';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const tools = [
  { key: 'businessAudit', href: 'business-audit', color: '#C7FF4A' },
  { key: 'websiteAudit', href: 'website-audit', color: '#6EE7F9' },
  { key: 'automationFinder', href: 'automation-finder', color: '#FF7A59' },
  { key: 'aiReadiness', href: 'ai-readiness', color: '#C7FF4A' },
  { key: 'toolStack', href: 'tool-stack', color: '#6EE7F9' },
  { key: 'leadFlow', href: 'lead-flow', color: '#FF7A59' },
] as const;
---

<BaseLayout
  title={t('nav.tools')}
  description={t('tools.section.subtitle')}
  lang={lang}
>
  <div class="py-16 lg:py-24">
    <div class="shift-container">
      <div class="mb-12">
        <p class="shift-label mb-3">{t('nav.tools')}</p>
        <h1 class="shift-heading-xl mb-4">{t('tools.section.title')}</h1>
        <p class="shift-body max-w-xl text-lg">{t('tools.section.subtitle')}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {tools.map((tool) => (
          <a
            href={`/${lang}/tools/${tool.href}`}
            class="shift-card-hover group flex flex-col gap-4 no-underline"
          >
            <div class="flex items-start justify-between gap-2">
              <h2 class="font-heading font-semibold text-shift-text text-lg group-hover:text-shift-accent transition-colors leading-snug">
                {t(`tools.${tool.key}.title` as any)}
              </h2>
              <span class="font-mono text-xs text-shift-muted border border-shift-line px-2 py-0.5 rounded-md flex-shrink-0 mt-1">
                {t(`tools.${tool.key}.time` as any)} {t('tools.time')}
              </span>
            </div>
            <p class="text-sm text-shift-muted leading-relaxed flex-1">
              {t(`tools.${tool.key}.desc` as any)}
            </p>
            <div class="flex items-center justify-between pt-3 border-t border-shift-line">
              <span class="text-xs font-mono text-shift-muted/60">
                {t(`tools.${tool.key}.output` as any)}
              </span>
              <span class="text-sm font-medium transition-colors" style={`color: ${tool.color}`}>
                {t('tools.cta')} →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
