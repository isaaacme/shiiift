  },
  {
    id: 'feministit',
    name: 'Feministit',
    url: 'https://isaaac.me/projects/feministit',
    tag: { he: 'תוכן / מגדר', en: 'Content / Gender', es: 'Contenido / Género', ru: 'Контент / Гендер' },
    desc: { he: 'מיזם תוכן פמיניסטי-קווירי — מאגר מידע על צדק חברתי, מגדר, להט"ב — בעברית, ערבית ואנגלית.', en: 'Feminist-queer content project — knowledge base on social justice, gender, LGBTQ — in Hebrew, Arabic & English.', es: 'Proyecto feminista-queer — base de conocimiento sobre justicia social, género, LGBTQ — en hebreo, árabe e inglés.', ru: 'Феминистско-квир контент-проект — база знаний о социальной справедливости, гендере, ЛГБТК+ — на иврите, арабском и английском.' },
