---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, useTranslations, type Locale } from '../../../i18n/index';

export function getStaticPaths() {
  const slugs = ['automatable-work', 'website-system', 'ai-reality-check', 'right-sized-crm'];
  return LOCALES.flatMap((lang) => slugs.map((slug) => ({ params: { lang, slug } })));
}

const { lang, slug } = Astro.params as { lang: Locale; slug: string };
const t = useTranslations(lang);

type ArticleData = {
  category: string;
  title: string;
  description: string;
  date: string;
  body: string[];
};

