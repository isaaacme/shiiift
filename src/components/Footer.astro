---
import { useTranslations, type Locale, LOCALES, getLocalizedPath } from '../i18n/index';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
---

<footer class="bg-shift-surface mt-16">
  <div class="shift-container py-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href={`/${lang}`} class="font-heading font-bold text-lg text-shift-text no-underline hover:text-shift-accent transition-colors flex items-center gap-2">
          <svg viewBox="0 0 738 738" class="w-5 h-5 rounded-md overflow-hidden flex-shrink-0 shadow-sm" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="738" height="738" fill="#FFE600"/>
            <path d="M353.418 436.404L330.543 96.0537H287.139L237.398 381.789H109.88V425.563H255.806L277.371 407.429L299.124 282.466L323.346 642.209H366.833L404.847 388.636L408.726 407.979L430.187 425.563L549.172 424.347L487.62 483.021L518.994 508.556L628.439 401.827L518.994 288.49L487.62 319.024L549.172 380.572L448.122 381.789L423.193 258.529H380.084L353.418 436.404Z" fill="black"/>
          </svg>
          <span>shiiift</span>
        </a>
        <p class="mt-2 text-sm text-shift-muted max-w-xs leading-relaxed">
          {t('footer.tagline')}
        </p>
        <div class="mt-4 flex items-center gap-4">
          <a href="https://www.linkedin.com/in/isaac-feldman/" target="_blank" rel="noopener noreferrer" class="text-shift-muted hover:text-shift-accent transition-colors" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
          <a href="https://x.com/isaaacme" target="_blank" rel="noopener noreferrer" class="text-shift-muted hover:text-shift-accent transition-colors" aria-label="X (Twitter)">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4l11.733 16h4.267l-11.733 -16z"/>
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/isaaacme" target="_blank" rel="noopener noreferrer" class="text-shift-muted hover:text-shift-accent transition-colors" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Tools & Pages -->
      <div>
        <p class="text-xs font-medium text-shift-text uppercase tracking-wider mb-4">{t('nav.tools')}</p>
        <ul class="space-y-2 text-sm text-shift-muted list-none p-0 m-0">
          <li><a href={`/${lang}/tools/business-audit`} class="hover:text-shift-text transition-colors no-underline">{t('tools.businessAudit.title')}</a></li>
          <li><a href={`/${lang}/tools/website-audit`} class="hover:text-shift-text transition-colors no-underline">{t('tools.websiteAudit.title')}</a></li>
          <li><a href={`/${lang}/tools/automation-finder`} class="hover:text-shift-text transition-colors no-underline">{t('tools.automationFinder.title')}</a></li>
          <li><a href={`/${lang}/tools/ai-readiness`} class="hover:text-shift-text transition-colors no-underline">{t('tools.aiReadiness.title')}</a></li>
          <li><a href={`/${lang}/tools/tool-stack`} class="hover:text-shift-text transition-colors no-underline">{t('tools.toolStack.title')}</a></li>
          <li><a href={`/${lang}/tools/lead-flow`} class="hover:text-shift-text transition-colors no-underline">{t('tools.leadFlow.title')}</a></li>
        </ul>
      </div>

      <!-- Site Links -->
      <div>
        <p class="text-xs font-medium text-shift-text uppercase tracking-wider mb-4">shiiift</p>
        <ul class="space-y-2 text-sm text-shift-muted list-none p-0 m-0">
          <li><a href={`/${lang}/thinking`} class="hover:text-shift-text transition-colors no-underline">{t('nav.thinking')}</a></li>
          <li><a href={`/${lang}/services`} class="hover:text-shift-text transition-colors no-underline">{t('services.label')}</a></li>
          <li><a href={`/${lang}/about`} class="hover:text-shift-text transition-colors no-underline">{t('about.label')}</a></li>
          <li><a href={`/${lang}/start`} class="hover:text-shift-text transition-colors no-underline">{t('nav.start')}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <p class="text-xs text-shift-muted">
        &copy; {year} shiiift. {t('footer.rights')}.
      </p>
      <div class="flex items-center gap-3 text-xs text-shift-muted">
        {LOCALES.map((locale, idx) => (
          <>
            {idx > 0 && <span class="text-shift-line">|</span>}
            {locale === lang ? (
              <span class="text-shift-accent font-medium uppercase">{locale}</span>
            ) : (
              <a href={getLocalizedPath(currentPath, locale)} class="hover:text-shift-text transition-colors no-underline uppercase">
                {locale}
              </a>
            )}
          </>
        ))}
      </div>
    </div>
  </div>
</footer>
