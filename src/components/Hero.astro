---
import { useTranslations, type Locale } from '../i18n/index';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden pt-20 pb-24 lg:pt-28 lg:pb-32 bg-grid">
  <!-- Background grid is handled by bg-grid class -->

  <!-- Layered Accent Glows -->
  <div class="absolute top-12 start-1/4 w-[500px] h-[350px] bg-shift-accent/6 rounded-full blur-[120px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-24 end-1/4 w-[450px] h-[300px] bg-shift-accent-2/4 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-48 start-1/3 w-[300px] h-[200px] bg-shift-warm/3 rounded-full blur-[90px] pointer-events-none" aria-hidden="true"></div>

  <div class="shift-container relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left: Massive Typography Poster Section -->
      <div class="lg:col-span-8 flex flex-col items-start">
        <!-- Pre-label -->
        <div class="inline-flex items-center gap-2 mb-8 reveal-on-scroll" style="--stagger-index: 0;">
          <span class="w-2 h-2 bg-shift-yellow rotate-12"></span>
          <span class="shift-label tracking-widest text-sm font-extrabold text-shift-blue">shiiift console v1.0</span>
        </div>

        <!-- Headline -->
        <h1 class="shift-heading-xl text-balance mb-8 reveal-on-scroll" style="--stagger-index: 1;">
          {t('hero.headline')}
        </h1>

        <!-- Staggered Layout for Subheadline & CTAs -->
        <div class="w-full lg:max-w-2xl reveal-on-scroll lg:ms-8" style="--stagger-index: 2;">
          <p class="text-lg sm:text-xl text-shift-muted leading-relaxed mb-10 text-balance font-medium">
            {t('hero.subheadline')}
          </p>

          <!-- CTAs with yellow background and rotation -->
          <div class="flex flex-wrap gap-4 items-center">
            <a href={`/${lang}/tools/business-audit`} class="shift-btn-primary text-base px-6 py-4 shadow-volume-md hover:shadow-volume-lg hover:-rotate-1">
              {t('hero.cta.primary')}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
            <a href={`/${lang}/thinking`} class="shift-btn-ghost text-base font-bold flex items-center gap-2 hover:translate-x-1 transition-transform">
              {t('hero.cta.tertiary')}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Interactive flow system, poster-like sidebar -->
      <div class="lg:col-span-4 w-full lg:mt-16 reveal-on-scroll" style="--stagger-index: 3;">
        <div class="shift-card w-full overflow-hidden backdrop-blur-md bg-opacity-70 border border-shift-line shadow-volume-lg">
          <div class="flex items-center justify-between mb-6">
            <p class="shift-label text-[10px]">
              {lang === 'he' ? 'זרימת מערכת תפעולית' : lang === 'ru' ? 'Операционный системный поток' : lang === 'es' ? 'Flujo del sistema operativo' : 'Operational System Flow'}
            </p>
            <span class="text-[9px] font-mono text-shift-muted/75 uppercase tracking-widest">Console v1.0.4</span>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {[
              { name: { he: 'טפסים', en: 'Forms', es: 'Formularios', ru: 'Формы' }, status: 'READY', color: 'accent' },
              { name: { he: 'וואטסאפ', en: 'WhatsApp', es: 'WhatsApp', ru: 'WhatsApp' }, status: 'LIVE', color: 'warm' },
              { name: { he: 'אימייל', en: 'Email', es: 'Email', ru: 'Email' }, status: 'SYNC', color: 'accent-2' },
              { name: { he: 'CRM', en: 'CRM', es: 'CRM', ru: 'CRM' }, status: 'CONN', color: 'accent' },
              { name: { he: 'חשבוניות', en: 'Invoices', es: 'Facturas', ru: 'Счета' }, status: 'AUTO', color: 'warm' },
              { name: { he: 'דוחות', en: 'Reports', es: 'Reportes', ru: 'Отчёты' }, status: 'LIVE', color: 'accent-2' },
              { name: { he: 'מעקב', en: 'Follow-ups', es: 'Seguimiento', ru: 'Ремаркетинг' }, status: 'RUN', color: 'accent' },
              { name: { he: 'אנליטיקס', en: 'Analytics', es: 'Analítica', ru: 'Аналитика' }, status: 'OK', color: 'accent-2' },
            ].map((item, i) => {
              const dotColor = item.color === 'accent' ? 'bg-shift-blue' : item.color === 'accent-2' ? 'bg-shift-accent-2' : 'bg-shift-yellow';
              const textColor = item.color === 'accent' ? 'text-shift-blue' : item.color === 'accent-2' ? 'text-shift-accent-2' : 'text-shift-muted';
              return (
                <div
                  class="bg-white border border-shift-line rounded-xl p-3 text-xs font-mono transition-all duration-150 hover:-translate-y-0.5 hover:shadow-volume-sm group"
                  style={`animation-delay: ${i * 80}ms`}
                >
                  <div class="flex items-center justify-between mb-2">
                    <span class={`w-1.5 h-1.5 rounded-full ${dotColor} animate-pulse`}></span>
                    <span class="text-[9px] text-shift-muted/75 font-mono tracking-wider">0{i+1}_SYS</span>
                  </div>
                  <p class="text-shift-text font-medium text-[13px] group-hover:text-shift-blue transition-colors">{item.name[lang] ?? item.name.en}</p>
                  <div class="mt-2 flex items-center justify-between pt-1.5 border-t border-[rgba(26,26,24,0.08)]">
                    <span class={`text-[9px] uppercase tracking-wider font-bold ${textColor}`}>{item.status}</span>
                    <span class="text-[8px] text-shift-muted/75">100ms</span>
                  </div>
                </div>
              );
            })}
          </div>
          <div class="mt-5 flex items-center gap-3">
            <div class="bg-shift-blue/10 border border-shift-line rounded-lg px-4 py-2 font-mono text-xs text-shift-blue font-bold shadow-volume-sm">
              {lang === 'he' ? 'מערכת' : lang === 'ru' ? 'Система' : lang === 'es' ? 'Sistema' : 'System'}
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-shift-blue rtl:rotate-180">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
            <div class="flex-1 h-0.5 bg-shift-text/20 relative overflow-hidden">
              <div class={`absolute inset-y-0 w-1/2 bg-gradient-to-r from-transparent via-shift-blue to-transparent animate-[shimmer_2s_ease-in-out_infinite] ${lang === 'he' ? 'end-0 shimmer-rtl' : 'start-0'}`}></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(200%); }
  }
  @keyframes shimmer-rtl {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-200%); }
  }
  .shimmer-rtl {
    animation-name: shimmer-rtl !important;
  }
</style>
