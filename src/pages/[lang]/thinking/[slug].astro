      <!-- Back Button -->
      <a href={`/${lang}/thinking`} class="shift-btn-ghost text-sm mb-8 inline-flex">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180 rotate-180"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        {backText}
      </a>

      <!-- Article Header -->
      <div class="mb-12 pb-8">
        <div class="flex items-center gap-2 mb-4">
          <span class="shift-label">
            {categories[article.category as keyof typeof categories][lang] || categories[article.category as keyof typeof categories]['en']}
          </span>
          <span class="w-1.5 h-1.5 rounded-full animate-pulse" style={`background-color: ${article.color}`}></span>
        </div>
        <h1 class="shift-heading-xl mb-4 leading-tight font-extrabold text-shift-text">
          {article.title[lang] || article.title['en']}
        </h1>
        <p class="text-lg text-shift-muted leading-relaxed mb-8">
          {article.subtitle[lang] || article.subtitle['en']}
        </p>
        <div class="aspect-[21/9] w-full overflow-hidden rounded-2xl border border-shift-line bg-shift-surface-soft shadow-sm dither-wrap-yellow">
          <img
            src={`/images/thinking/${slug}.png`}
            alt={article.title[lang] || article.title['en']}
            class="w-full h-full object-cover dither-img"
          />
        </div>
      </div>

      <!-- Framework Content -->
      <div class="space-y-12 text-shift-text leading-relaxed">
        
        <!-- 1. Situation -->
        <section class="space-y-4">
          <h2 class="font-heading font-bold text-xl sm:text-2xl text-shift-text border-s-4 px-3" style={`border-color: ${article.color}`}>
            {headings.situation[lang] || headings.situation['en']}
          </h2>
          {(article.situation[lang] || article.situation['en']).map((p) => (
            <p class="text-sm sm:text-base text-shift-muted leading-relaxed">{p}</p>
          ))}
        </section>

        <!-- 2. Issues -->
        <section class="space-y-4">
          <h2 class="font-heading font-bold text-xl sm:text-2xl text-shift-text border-s-4 px-3" style={`border-color: ${article.color}`}>
            {headings.issues[lang] || headings.issues['en']}
          </h2>
          <ul class="space-y-3 list-none p-0 m-0">
            {(article.issues[lang] || article.issues['en']).map((p) => (
              <li class="flex items-start gap-3 text-sm sm:text-base text-shift-muted">
                <span class="text-red-400 font-bold mt-0.5">✕</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- 3. Opportunity -->
        <section class="space-y-4">
          <h2 class="font-heading font-bold text-xl sm:text-2xl text-shift-text border-s-4 px-3" style={`border-color: ${article.color}`}>
            {headings.opportunity[lang] || headings.opportunity['en']}
          </h2>
          {(article.opportunity[lang] || article.opportunity['en']).map((p) => (
            <p class="text-sm sm:text-base text-shift-muted leading-relaxed">{p}</p>
          ))}
        </section>

        <!-- Visual Diagram / Graph Section -->
        <section class="space-y-4 bg-shift-surface border border-shift-line rounded-2xl p-6 sm:p-8">
          <p class="font-mono text-xs text-shift-accent uppercase tracking-widest">
            {headings.diagram[lang] || headings.diagram['en']}
          </p>

          {slug === 'automatable-work' && (
            <div class="py-4 flex justify-center">
              <svg viewBox="0 0 600 200" class="w-full max-w-xl h-auto text-shift-muted" fill="none" stroke="currentColor" stroke-width="1.5">
                <!-- Node 1 -->
                <rect x="10" y="70" width="100" height="60" rx="8" fill="#18181B" stroke="#FF7A59" />
                <text x="60" y="100" font-family="sans-serif" font-size="11" fill="#fff" text-anchor="middle" font-weight="bold">Lead Intake</text>
                <text x="60" y="115" font-family="monospace" font-size="9" fill="#888" text-anchor="middle">Form / API</text>
                
                <!-- Arrow 1 -->
                <path d="M110 100 H160" marker-end="url(#arrow)" stroke="#FF7A59" stroke-dasharray="3 3" />

                <!-- Node 2 -->
                <rect x="170" y="70" width="110" height="60" rx="8" fill="#18181B" stroke="#6EE7F9" />
                <text x="225" y="100" font-family="sans-serif" font-size="11" fill="#fff" text-anchor="middle" font-weight="bold">Auto-Qualifier</text>
                <text x="225" y="115" font-family="monospace" font-size="9" fill="#888" text-anchor="middle">Rules Engine</text>

                <!-- Arrow 2 -->
                <path d="M280 100 H330" marker-end="url(#arrow)" stroke="#6EE7F9" />

                <!-- Node 3 -->
                <rect x="340" y="70" width="100" height="60" rx="8" fill="#18181B" stroke="#C7FF4A" />
                <text x="390" y="100" font-family="sans-serif" font-size="11" fill="#fff" text-anchor="middle" font-weight="bold">Sync CRM</text>
                <text x="390" y="115" font-family="monospace" font-size="9" fill="#888" text-anchor="middle">Deal Created</text>

                <!-- Arrow 3 -->
                <path d="M440 100 H490" marker-end="url(#arrow)" stroke="#C7FF4A" />

                <!-- Node 4 -->
                <rect x="500" y="70" width="90" height="60" rx="8" fill="#18181B" stroke="#C7FF4A" />
                <text x="545" y="100" font-family="sans-serif" font-size="11" fill="#fff" text-anchor="middle" font-weight="bold">Cal Link</text>
                <text x="545" y="115" font-family="monospace" font-size="9" fill="#888" text-anchor="middle">Auto-Invite</text>
                
                <defs>
                  <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M 0 2 L 8 5 L 0 8 z" fill="currentColor"/>
                  </marker>
                </defs>
              </svg>
            </div>
          )}

          {slug === 'right-sized-crm' && (
            <div class="py-4 flex justify-center">
              <svg viewBox="0 0 600 200" class="w-full max-w-xl h-auto text-shift-muted" fill="none" stroke="currentColor" stroke-width="1.5">
                <!-- Pipeline Lanes -->
                <!-- Stage 1 -->
                <rect x="20" y="30" width="160" height="140" rx="8" fill="#18181B" stroke="#6EE7F9" stroke-opacity="0.5" />
                <text x="100" y="55" font-family="sans-serif" font-size="12" fill="#6EE7F9" text-anchor="middle" font-weight="bold">1. NEW LEAD</text>
                <rect x="40" y="70" width="120" height="30" rx="4" fill="#27272A" stroke="#444" />
                <text x="100" y="88" font-family="sans-serif" font-size="10" fill="#fff" text-anchor="middle">Inquiry #2894</text>
                
                <!-- Stage 2 -->
                <rect x="220" y="30" width="160" height="140" rx="8" fill="#18181B" stroke="#FF7A59" stroke-opacity="0.5" />
                <text x="300" y="55" font-family="sans-serif" font-size="12" fill="#FF7A59" text-anchor="middle" font-weight="bold">2. ENGAGED</text>
                <rect x="240" y="70" width="120" height="30" rx="4" fill="#27272A" stroke="#444" />
                <text x="300" y="88" font-family="sans-serif" font-size="10" fill="#fff" text-anchor="middle">Demo Booked</text>

                <!-- Stage 3 -->
                <rect x="420" y="30" width="160" height="140" rx="8" fill="#18181B" stroke="#C7FF4A" stroke-opacity="0.5" />
                <text x="500" y="55" font-family="sans-serif" font-size="12" fill="#C7FF4A" text-anchor="middle" font-weight="bold">3. CLOSED</text>
                <rect x="440" y="70" width="120" height="30" rx="4" fill="#27272A" stroke="#C7FF4A" stroke-opacity="0.3" />
                <text x="500" y="88" font-family="sans-serif" font-size="10" fill="#C7FF4A" text-anchor="middle" font-weight="bold">Won $4,500</text>
              </svg>
            </div>
          )}

          {slug === 'website-system' && (
            <div class="py-4 flex justify-center">
              <svg viewBox="0 0 600 200" class="w-full max-w-xl h-auto text-shift-muted" fill="none" stroke="currentColor" stroke-width="1.5">
                <!-- Flow chart Brochure vs System -->
                <!-- Brochure path -->
                <text x="50" y="40" font-family="monospace" font-size="10" fill="#FF7A59" font-weight="bold">BROCHURE (BROKEN)</text>
                <rect x="50" y="60" width="130" height="40" rx="6" fill="#18181B" stroke="#FF7A59" />
                <text x="115" y="84" font-family="sans-serif" font-size="10" fill="#fff" text-anchor="middle">Static Webpage</text>
                <path d="M180 80 H230" stroke="#FF7A59" marker-end="url(#arrow)" />
                <rect x="240" y="60" width="110" height="40" rx="6" fill="#18181B" stroke="#999" />
                <text x="295" y="84" font-family="sans-serif" font-size="10" fill="#fff" text-anchor="middle">Generic Form</text>
                <path d="M350 80 H400" stroke="#999" marker-end="url(#arrow)" />
                <text x="440" y="84" font-family="sans-serif" font-size="10" fill="#FF7A59" text-anchor="middle">Leaves / 404</text>

                <!-- System path -->
                <text x="50" y="130" font-family="monospace" font-size="10" fill="#C7FF4A" font-weight="bold">SYSTEM (EFFICIENT)</text>
                <rect x="50" y="140" width="130" height="45" rx="6" fill="#18181B" stroke="#C7FF4A" />
                <text x="115" y="166" font-family="sans-serif" font-size="10" fill="#fff" text-anchor="middle">Self-Audit Form</text>
                <path d="M180 162.5 H230" stroke="#C7FF4A" marker-end="url(#arrow)" />
                <rect x="240" y="140" width="110" height="45" rx="6" fill="#18181B" stroke="#C7FF4A" />
                <text x="295" y="166" font-family="sans-serif" font-size="10" fill="#fff" text-anchor="middle">Auto-Qualifier</text>
                <path d="M350 162.5 H400" stroke="#C7FF4A" marker-end="url(#arrow)" />
                <rect x="410" y="140" width="130" height="45" rx="6" fill="#18181B" stroke="#C7FF4A" />
                <text x="475" y="166" font-family="sans-serif" font-size="10" fill="#fff" text-anchor="middle">CRM & Cal Sync</text>
              </svg>
            </div>
          )}

          {slug === 'ai-reality-check' && (
            <div class="py-4 flex justify-center">
              <svg viewBox="0 0 600 200" class="w-full max-w-xl h-auto text-shift-muted" fill="none" stroke="currentColor" stroke-width="1.5">
                <!-- AI Engine flowchart -->
                <rect x="20" y="70" width="120" height="60" rx="8" fill="#18181B" stroke="#6EE7F9" />
                <text x="80" y="98" font-family="sans-serif" font-size="11" fill="#fff" text-anchor="middle" font-weight="bold">1. Input Text</text>
                <text x="80" y="113" font-family="monospace" font-size="9" fill="#888" text-anchor="middle">Email/PDF/Form</text>

                <path d="M140 100 H190" stroke="#6EE7F9" marker-end="url(#arrow)" />

                <rect x="200" y="70" width="140" height="60" rx="8" fill="#18181B" stroke="#FF7A59" />
                <text x="270" y="98" font-family="sans-serif" font-size="11" fill="#fff" text-anchor="middle" font-weight="bold">2. LLM Parser</text>
                <text x="270" y="113" font-family="monospace" font-size="9" fill="#888" text-anchor="middle">Classify & Draft</text>

                <path d="M340 100 H390" stroke="#FF7A59" marker-end="url(#arrow)" />

                <rect x="400" y="70" width="170" height="60" rx="8" fill="#18181B" stroke="#C7FF4A" />
                <text x="485" y="98" font-family="sans-serif" font-size="11" fill="#fff" text-anchor="middle" font-weight="bold">3. Human Review</text>
                <text x="485" y="113" font-family="monospace" font-size="9" fill="#888" text-anchor="middle">Approve / Correct</text>
              </svg>
            </div>
          )}
        </section>

        <!-- 4. Checklist -->
        <section class="space-y-5">
          <h2 class="font-heading font-bold text-xl sm:text-2xl text-shift-text border-s-4 px-3" style={`border-color: ${article.color}`}>
            {headings.checklist[lang] || headings.checklist['en']}
          </h2>
          <div class="grid grid-cols-1 gap-3">
            {(article.checklist[lang] || article.checklist['en']).map((item, index) => (
              <div class="flex items-start gap-4 p-4 bg-shift-surface border border-shift-line rounded-xl hover:border-shift-muted/30 transition-colors">
                <span class="font-mono text-xs text-shift-muted flex-shrink-0 w-6 h-6 rounded-full bg-shift-surface-soft border border-shift-line flex items-center justify-center mt-0.5">
                  {index + 1}
                </span>
                <span class="text-sm text-shift-text leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </section>

      </div>

      <!-- 5. Interactive Contact Form -->
      <div id="cta-form-container" class="mt-20 pt-12">
        <div class="mb-8 text-center sm:text-start">
          <h2 class="font-heading font-bold text-2xl text-shift-text mb-2">
            {tForm.title[lang] || tForm.title['en']}
          </h2>
          <p class="text-sm text-shift-muted">
            {tForm.desc[lang] || tForm.desc['en']}
          </p>
        </div>

        <form
          id="article-contact-form"
          name={`article-${slug}`}
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-5 bg-shift-surface border border-shift-line rounded-2xl p-6 sm:p-8"
        >
          <input type="hidden" name="form-name" value={`article-${slug}`} />
          <input type="hidden" name="source" value={`article_${slug}`} />
          <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="shift-label block mb-2" for="name">{tForm.name[lang] || tForm.name['en']}</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder={tForm.placeholderName[lang] || tForm.placeholderName['en']}
                class="w-full bg-shift-bg border border-shift-line rounded-xl px-4 py-3 text-shift-text placeholder-shift-muted/30 outline-none focus:border-shift-accent/40 transition-colors text-sm"
              />
            </div>
            <div>
              <label class="shift-label block mb-2" for="email">{tForm.email[lang] || tForm.email['en']}</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder={tForm.placeholderEmail[lang] || tForm.placeholderEmail['en']}
                class="w-full bg-shift-bg border border-shift-line rounded-xl px-4 py-3 text-shift-text placeholder-shift-muted/30 outline-none focus:border-shift-accent/40 transition-colors text-sm"
              />
            </div>
          </div>

          <div>
            <label class="shift-label block mb-2" for="message">{tForm.message[lang] || tForm.message['en']}</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder={tForm.placeholderMessage[lang] || tForm.placeholderMessage['en']}
              class="w-full bg-shift-bg border border-shift-line rounded-xl px-4 py-3 text-shift-text placeholder-shift-muted/30 outline-none focus:border-shift-accent/40 transition-colors text-sm resize-none"
            ></textarea>
          </div>

          <button type="submit" class="shift-btn-primary w-full justify-center text-base py-4" style={`background-color: ${article.color}; color: #000; border-color: ${article.color}`}>
            {tForm.submit[lang] || tForm.submit['en']}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>

          <p class="text-xs text-shift-muted/75 text-center">{tForm.disclaimer[lang] || tForm.disclaimer['en']}</p>
        </form>

        <div id="form-success-message" class="hidden bg-shift-surface border border-shift-line text-shift-accent rounded-xl p-5 text-center text-sm font-medium mt-4">
          {tForm.success[lang] || tForm.success['en']}
        </div>

        <script define:vars={{ slug }}>
          const form = document.getElementById('article-contact-form');
          const successBox = document.getElementById('form-success-message');
          form?.addEventListener('submit', (e) => {
            e.preventDefault();
            const email = document.getElementById('email')?.value;
            const name = document.getElementById('name')?.value;
            const message = document.getElementById('message')?.value;
            
            if (email) {
              fetch('/api/subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, name, source: `article_${slug}` }),
                keepalive: true
              })
              .then(() => {
                form.reset();
                form.classList.add('hidden');
                successBox?.classList.remove('hidden');
              })
              .catch(() => {
                // Fail silently or fallback to submitting form
                form.submit();
              });
            }
          });
        </script>
      </div>

    </div>
  </div>
</BaseLayout>
