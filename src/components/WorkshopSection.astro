---
import { useTranslations, type Locale } from '../i18n/index';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const topics = [1, 2, 3, 4, 5, 6] as const;
---

<section class="py-16 lg:py-24 border-t border-shift-line">
  <div class="shift-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Content -->
      <div>
        <p class="shift-label mb-3">{t('workshop.label')}</p>
        <h2 class="shift-heading-lg text-balance mb-5">{t('workshop.title')}</h2>
        <p class="shift-body mb-8 max-w-lg">{t('workshop.desc')}</p>

        <div class="flex flex-wrap gap-3">
          <a href={`/${lang}/workshop`} class="shift-btn-primary">
            {t('workshop.cta.primary')}
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="6 3 20 12 6 21 6 3"/>
            </svg>
          </a>
          <a href={`/${lang}/workshop#checklist`} class="shift-btn-secondary">
            {t('workshop.cta.secondary')}
          </a>
        </div>
      </div>

      <!-- Topics list -->
      <div class="shift-card">
        <div class="flex items-center justify-between mb-5">
          <p class="shift-label">30 MIN SESSION</p>
          <span class="text-[10px] font-mono text-shift-accent border border-shift-accent/20 bg-shift-accent/5 px-2 py-0.5 rounded-md">LIVE BOARD</span>
        </div>
        <ul class="space-y-4 list-none p-0 m-0">
          {topics.map((n) => (
            <li class="flex items-start gap-3 group/item">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-shift-surface-soft border border-shift-line flex items-center justify-center mt-0.5 group-hover/item:border-shift-accent group-hover/item:bg-shift-accent/5 transition-all">
                <span class="font-mono text-[10px] text-shift-muted group-hover/item:text-shift-accent transition-colors">{n}</span>
              </span>
              <span class="text-sm text-shift-muted group-hover/item:text-shift-text transition-colors leading-snug">
                {t(`workshop.topics.${n}` as any)}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
