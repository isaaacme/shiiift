---
import { type Locale } from '../i18n/index';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const label = {
  he: 'עבדנו עם',
  en: 'Worked with',
  es: 'Hemos trabajado con',
  ru: 'Работали с',
};

const logos = [
  'BRIDGIFY',
  'SWU',
  'PAZ INTERACTIVE',
  'ALCHEMIQ',
  'DOUGLAS & BLOOMBERG',
  'ENHANCE',
  'TREK MARKET',
  'FEMINISTIT',
  'CHEETAH',
];
---

<div class="logos-carousel-section py-10 border-t border-shift-line">
  <p class="font-mono text-[10px] tracking-widest uppercase text-shift-muted text-center mb-8">
    {label[lang]}
  </p>

  <!-- outer wrapper clips the overflow -->
  <div class="marquee-outer" aria-hidden="true">
    <!-- fade edges -->
    <div class="marquee-fade-left"></div>
    <div class="marquee-fade-right"></div>

    <!-- scrolling band: two identical copies side by side -->
    <div class="marquee-track">
      <!-- copy A -->
      <div class="marquee-set">
        {logos.map((name) => (
          <>
            <span class="marquee-item">{name}</span>
            <span class="marquee-sep">◆</span>
          </>
        ))}
      </div>
      <!-- copy B (identical — for the seamless loop) -->
      <div class="marquee-set" aria-hidden="true">
        {logos.map((name) => (
          <>
            <span class="marquee-item">{name}</span>
            <span class="marquee-sep">◆</span>
          </>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-outer {
    position: relative;
    overflow: hidden;
  }

  .marquee-fade-left,
  .marquee-fade-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 6rem;
    z-index: 10;
    pointer-events: none;
  }

  .marquee-fade-left {
    left: 0;
    background: linear-gradient(to right, #F2F1EF 0%, transparent 100%);
  }

  .marquee-fade-right {
    right: 0;
    background: linear-gradient(to left, #F2F1EF 0%, transparent 100%);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    /* animate exactly one copy-width to the left, then snap back to 0 — seamless */
    animation: marquee-scroll 28s linear infinite;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  .marquee-set {
    display: flex;
    align-items: center;
    /* padding-inline-end creates the gap between the two sets */
    padding-inline-end: 3rem;
  }

  .marquee-item {
    font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    white-space: nowrap;
    color: rgba(26, 26, 24, 0.30);
    transition: color 0.3s;
    padding-inline: 1.5rem;
  }

  .marquee-item:hover {
    color: rgba(26, 26, 24, 0.65);
  }

  .marquee-sep {
    font-family: ui-monospace, monospace;
    font-size: 0.5rem;
    color: rgba(61, 122, 95, 0.30);
    flex-shrink: 0;
  }

  @keyframes marquee-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
