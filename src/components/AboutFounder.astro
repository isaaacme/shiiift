---
import { type Locale } from '../i18n/index';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const labels = {
  sectionLabel:  { he: 'על המייסד', en: 'About the founder', es: 'Sobre el fundador', ru: 'Об основателе' },
  name:          { he: 'יצחק פלדמן', en: 'Isaac Feldman', es: 'Isaac Feldman', ru: 'Исаак Фельдман' },
  role:          { he: 'מייסד Shiiift — יישום טכנולוגי ואסטרטגיה', en: 'Founder of Shiiift — Technical Implementation & Strategy', es: 'Fundador de Shiiift — Implementación técnica y estrategia', ru: 'Основатель Shiiift — Техническое внедрение и стратегия' },
  canHelpTitle:  { he: 'במה אני יכול לעזור', en: 'How I can help', es: 'Cómo puedo ayudar', ru: 'Чем могу помочь' },
  projectsTitle: { he: 'פרויקטים נבחרים', en: 'Selected projects', es: 'Proyectos seleccionados', ru: 'Избранные проекты' },
  expTitle:      { he: 'ניסיון והסמכות', en: 'Experience & qualifications', es: 'Experiencia y calificaciones', ru: 'Опыт и квалификации' },
  viewProject:   { he: 'צפה בפרויקט', en: 'View project', es: 'Ver proyecto', ru: 'Смотреть проект' },
  close:         { he: 'סגור', en: 'Close', es: 'Cerrar', ru: 'Закрыть' },
  bioParagraphs: {
    he: [
      "אני יצחק פלדמן, מייסד Shiiift.",
      "הרקע שלי הוא בעיצוב, פיתוח אתרים, אסטרטגיה דיגיטלית ויישום טכנולוגי. במהלך השנים עבדתי במיתוג, חוויית משתמש (UX), וורדפרס, שופיפיי, אוטומציה, אנליטיקס, SEO ומערכות דיגיטליות מותאמות אישית.",
      "מה שמחבר בין כל העבודה הזו הוא רעיון פשוט: טכנולוגיה צריכה להקל על ניהול העסק.",
      "הקמתי את Shiiift כדי לעזור לעסקים להתקדם מעבר לכלים מנותקים, עבודה ידנית חוזרת ונשנית ומערכות דיגיטליות שמייצרות יותר חיכוך מאשר פתרונות.",
      "התפקיד שלי הוא להבין כיצד העסק פועל בפועל, לזהות היכן הולכים לאיבוד זמן, לידים ומומנטום, ואז לעצב פתרון מעשי עבורו.",
      "הפתרון הזה יכול להיות אתר אינטרנט טוב יותר, תהליך עבודה אוטומטי, כלי פנימי, תהליך CRM מחובר, מערכת מבוססת AI, או שילוב של כמה דברים שעובדים יחד.",
      "אני עובד בצורה מעשית ואישית משלב האסטרטגיה ועד ליישום, מה שאומר שהחשיבה והביצוע נשארים מחוברים.",
      "Shiiift אינה בנויה סביב מכירת שירות קבוע אחד. היא בנויה סביב מציאת הצעד הטכנולוגי הנכון עבור כל עסק והפיכתו למציאות.",
      "מערכות ברורות. טכנולוגיה שימושית. פחות חיכוך."
    ],
    en: [
      "I’m Isaac Feldman, founder of Shiiift.",
      "My background is in design, web development, digital strategy, and technical implementation. Over the years, I’ve worked across branding, UX, WordPress, Shopify, automation, analytics, SEO, and custom digital systems.",
      "What connects all of that work is a simple idea: technology should make a business easier to run.",
      "I started Shiiift to help businesses move beyond disconnected tools, repetitive manual work, and digital systems that create more friction than they solve.",
      "My role is to understand how a business actually works, identify where time, leads, and momentum are being lost, and then design a practical solution around it.",
      "That solution might be a better website, an automated workflow, an internal tool, a connected CRM process, an AI-assisted system, or a combination of several things working together.",
      "I work hands-on from strategy through implementation, which means the thinking and the execution stay connected.",
      "Shiiift is not built around selling one fixed service. It is built around finding the right technical move for each business and making it real.",
      "Clear systems. Useful technology. Less friction."
    ],
    es: [
      "Soy Isaac Feldman, fundador de Shiiift.",
      "Mi experiencia abarca diseño, desarrollo web, estrategia digital e implementación técnica. A lo largo de los años, he trabajado en branding, UX, WordPress, Shopify, automatización, analítica, SEO y sistemas digitales a medida.",
      "Lo que conecta todo ese trabajo es una idea simple: la tecnología debería facilitar la gestión de un negocio.",
      "Fundé Shiiift para ayudar a las empresas a ir más allá de herramientas desconectadas, trabajo manual repetitivo y sistemas digitales que crean más fricción de la que resuelven.",
      "Mi función es entender cómo funciona realmente un negocio, identificar dónde se están perdiendo tiempo, leads y el impulso, y luego diseñar una solución práctica para ello.",
      "Esa solución puede ser un mejor sitio web, un flujo de trabajo automatizado, una herramienta interna, un proceso de CRM conectado, un sistema asistido por IA o una combinación de varias cosas trabajando juntas.",
      "Trabajo de manera práctica desde la estrategia hasta la implementación, lo que significa que el pensamiento y la ejecución permanecen conectados.",
      "Shiiift no se basa en vender un único servicio fijo. Se basa en encontrar el movimiento técnico adecuado para cada negocio y hacerlo realidad.",
      "Sistemas claros. Tecnología útil. Menos fricción."
    ],
    ru: [
      "Я Исаак Фельдман, основатель Shiiift.",
      "Мой опыт включает дизайн, веб-разработку, цифровую стратегию и техническое внедрение. За эти годы я работал с брендингом, UX, WordPress, Shopify, автоматизацией, аналитикой, SEO и заказными цифровыми системами.",
      "Все эти направления связывает одна простая идея: технологии должны облегчать ведение бизнеса.",
      "Я создал Shiiift, чтобы помочь бизнесу избавиться от разрозненных инструментов, рутинной ручной работы и цифровых систем, которые создают больше проблем, чем решают.",
      "Моя роль — понять, как на самом деле устроен бизнес, определить, где теряются время, лиды и динамика развития, а затем разработать практическое решение.",
      "Этим решением может стать качественный веб-сайт, автоматизированный рабочий процесс, внутренний инструмент, связанный процесс в CRM, система с поддержкой ИИ или сочетание нескольких решений, работающих вместе.",
      "Я лично веду проекты от стратегии до внедрения, благодаря чему концепция и ее реализация остаются неразрывно связанными.",
      "Shiiift не продает одну фиксированную услугу. Мы находим правильное технологическое решение для конкретного бизнеса и воплощаем его в жизнь.",
      "Понятные системы. Полезные технологии. Меньше трения."
    ]
  }
};

function gl(o: Record<string, string>) { return o[lang] ?? o['en'] ?? ''; }
function glParagraphs(o: Record<string, string[]>) { return o[lang] ?? o['en'] ?? []; }

const skills = [
  { he: 'פיתוח אתרי פרימיום (Astro, React, WordPress)', en: 'Premium web development (Astro, React, WordPress)', es: 'Desarrollo web premium (Astro, React, WordPress)', ru: 'Разработка премиум-сайтов (Astro, React, WordPress)' },
  { he: 'SEO טכני מתקדם ואופטימיזציית ביצועים', en: 'Advanced technical SEO & performance optimisation', es: 'SEO técnico avanzado y optimización de rendimiento', ru: 'Продвинутое техническое SEO и оптимизация производительности' },
  { he: 'אוטומציות ואינטגרציות בין מערכות', en: 'Automations & system integrations', es: 'Automatizaciones e integraciones de sistemas', ru: 'Автоматизации и системные интеграции' },
  { he: 'עיצוב UX/UI וחוויית משתמש', en: 'UX/UI design & user experience', es: 'Diseño UX/UI y experiencia de usuario', ru: 'UX/UI-дизайн и пользовательский опыт' },
  { he: 'אסטרטגיה דיגיטלית ומיתוג', en: 'Digital strategy & branding', es: 'Estrategia digital y branding', ru: 'Цифровая стратегия и брендинг' },
  { he: 'הדרכה ומנטורינג לעולם הווב', en: 'Web & design mentoring', es: 'Mentoría en web y diseño', ru: 'Наставничество в сфере веба и дизайна' },
];

const experience = [
  {
    year: '2014 –',
    title: { he: 'פרילנסר עצמאי — בניית אתרים, SEO ועיצוב', en: 'Independent freelancer — web, SEO & design', es: 'Freelancer independiente — web, SEO y diseño', ru: 'Независимый фрилансер — веб, SEO и дизайн' },
    note:  { he: 'לקוחות בישראל, אירופה וצפון אמריקה', en: 'Clients in Israel, Europe & North America', es: 'Clientes en Israel, Europa y América del Norte', ru: 'Клиенты в Израиле, Европе и Северной Америке' },
  },
  {
    year: '',
    title: { he: 'שותף טכני — פז אינטראקטיב', en: 'Technical partner — Paz Interactive', es: 'Socio técnico — Paz Interactive', ru: 'Технический партнёр — Paz Interactive' },
    note:  { he: 'סוכנות דיגיטלית, תל אביב — ניו יורק', en: 'Digital agency, Tel Aviv – New York', es: 'Agencia digital, Tel Aviv – Nueva York', ru: 'Цифровое агентство, Тель-Авив – Нью-Йорк' },
  },
  {
    year: '',
    title: { he: 'ייעוץ SEO — פרויקטים טכנולוגיים', en: 'SEO consulting — tech projects', es: 'Consultoría SEO — proyectos tecnológicos', ru: 'SEO-консалтинг — технологические проекты' },
    note:  { he: 'Bridgify, Alchemiq, Enhance ועוד', en: 'Bridgify, Alchemiq, Enhance & more', es: 'Bridgify, Alchemiq, Enhance y más', ru: 'Bridgify, Alchemiq, Enhance и другие' },
  },
];

const projects = [
  {
    id: 'alchemiq',
    name: 'Alchemiq',
    url: 'https://isaaac.me/projects/alchemiq',
    tag: { he: 'AI / מדיה', en: 'AI / Media', es: 'AI / Medios', ru: 'AI / Медиа' },
    desc: { he: 'חברת AI בתחום ניתוח חדשות — מסייעת בהבנת תוכן ומפחיתה דיסאינפורמציה.', en: 'AI company in the news-analysis space — helps understand content and reduce disinformation.', es: 'Empresa de IA en análisis de noticias — ayuda a entender contenido y reducir desinformación.', ru: 'ИИ-компания в сфере анализа новостей — помогает понимать контент и снижать дезинформацию.' },
  },
  {
    id: 'bridgify',
    name: 'Bridgify',
    url: 'https://isaaac.me/projects/bridgify',
    tag: { he: 'טכנולוגיה / תיירות', en: 'Tech / Travel', es: 'Tecnología / Viajes', ru: 'Технологии / Туризм' },
    desc: { he: 'פתרון white-label לקמעונאי נסיעות — מספק מסלולי טיול מותאמים אישית ביעד.', en: 'White-label solution for travel retailers — provides personalised itineraries at destination.', es: 'Solución white-label para minoristas de viajes — itinerarios personalizados en destino.', ru: 'White-label решение для туристических ритейлеров — персонализированные маршруты в пункте назначения.' },
  },
  {
    id: 'cheetah-restaurant',
    name: 'Cheetah Restaurant',
    url: 'https://isaaac.me/projects/cheetah-restaurant',
    tag: { he: 'אי-קומרס / מזון', en: 'E-commerce / Food', es: 'E-commerce / Alimentación', ru: 'E-commerce / Еда' },
    desc: { he: 'אפליקציית אי-קומרס למפיצי מזון.', en: 'E-commerce app for food distributors.', es: 'App de e-commerce para distribuidores de alimentos.', ru: 'E-commerce приложение для дистрибьюторов продуктов питания.' },
  },
  {
    id: 'douglas-bloomberg',
    name: 'Douglas & Bloomberg',
    url: 'https://isaaac.me/projects/douglas-bloomberg',
    tag: { he: 'פינטק / אירופה', en: 'Fintech / Europe', es: 'Fintech / Europa', ru: 'Финтех / Европа' },
    desc: { he: 'חברת מימון המוני אירופאית.', en: 'European crowdfunding company.', es: 'Empresa europea de financiación colectiva.', ru: 'Европейская краудфандинговая компания.' },
  },
  {
    id: 'enhance',
    name: 'Enhance',
    url: 'https://isaaac.me/projects/enhance',
