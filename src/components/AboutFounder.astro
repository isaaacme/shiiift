    note:  { he: 'Bridgify, Alchemiq, Enhance ועוד', en: 'Bridgify, Alchemiq, Enhance & more', es: 'Bridgify, Alchemiq, Enhance y más', ru: 'Bridgify, Alchemiq, Enhance и другие' },
